---
import { SCHEDULING_URL } from '../consts';

interface Props {
  title?: string;
  text?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Tell Omnipeak what your business needs to run on',
  text = 'A 20-minute call, in plain language, about what you have now and what it should be doing instead. Then a written proposal with a fixed scope and a fixed price, before any building starts.',
  secondaryLabel = 'See how projects run',
  secondaryHref = '/process/',
} = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="card card--raised cta">
      <h2>{title}</h2>
      <p class="lede">{text}</p>
      <div class="btn-row">
        <a href={SCHEDULING_URL} class="btn btn--primary">Book an intro call</a>
        <a href={secondaryHref} class="btn btn--ghost">{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
