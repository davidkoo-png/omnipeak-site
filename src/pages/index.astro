---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTA from '../components/CTA.astro';
import { SCHEDULING_URL } from '../consts';
---

<BaseLayout
  title="Omnipeak — Custom software, no handoffs"
  description="Omnipeak builds booking systems, internal tools, automations, and rescues of stalled projects for small businesses. The person who understands your business writes the code, and your business owns everything it builds."
>
  <section class="hero section--dark">
    <span class="sticker" aria-hidden="true" style="width:14px;height:14px;top:14%;left:46%;background:var(--accent-pink);"></span>
    <span class="sticker" aria-hidden="true" style="width:10px;height:10px;top:90%;left:3%;background:var(--accent-sky);"></span>
    <span class="sticker" aria-hidden="true" style="width:18px;height:18px;top:8%;right:6%;background:var(--accent-purple);"></span>
    <span class="sticker" aria-hidden="true" style="width:12px;height:12px;bottom:10%;right:38%;background:var(--accent-orange);"></span>

    <div class="container">
      <div class="hero__inner">
        <div class="hero__content">
          <span class="eyebrow">Custom software for small businesses</span>
          <h1>The person who understands your business is the one writing the code.</h1>
          <p class="lede">
            Booking and membership systems, internal tools, automations, and rescues of stalled
            projects. Whatever Omnipeak builds, your business owns it: the code, the hosting, and
            the accounts, from day one.
          </p>
          <div class="btn-row">
            <a href={SCHEDULING_URL} class="btn btn--primary">Book an intro call</a>
            <a href="/work/" class="btn btn--outline">See the work</a>
          </div>
          <p class="hero__note">A free 20-minute call, in plain language. No obligation.</p>
        </div>

        <figure class="browser">
          <div class="browser__frame">
            <div class="browser__bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img
              src="/work/smash-factor-booking.png"
              alt="Smash Factor Lounge booking screen: a grid of simulator bays by hour, showing open slots with regular and member prices and slots already taken."
              width="1316"
              height="997"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption>Live booking system built for <a href="/work/">Smash Factor Lounge</a></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        title="Small businesses whose tech has fallen behind"
        subtitle="The tool almost fits but not quite, the workaround has become the process, or a developer left a half-built system behind."
      />
      <ul class="fits">
        <li>Outgrew spreadsheets</li>
        <li>Off-the-shelf almost fits</li>
        <li>Repetitive work done by hand</li>
        <li>Inherited a half-built system</li>
        <li>Data in five places</li>
        <li>Reports rebuilt every month</li>
      </ul>
    </div>
  </section>

  <section class="section section--dim">
    <div class="container">
      <SectionHeader title="What working with Omnipeak is like" />
      <div class="pillars">
        <div class="pillar">
          <h3>No handoffs</h3>
          <p>
            Your business isn't passed from a salesperson to a project manager to a developer.
            The person who listens to you builds it, so what you asked for is what you get.
          </p>
        </div>
        <div class="pillar">
          <h3>Clear communication</h3>
          <p>
            Updates come in plain English, not tech jargon. You always know what's happening,
            what's next, and why.
          </p>
        </div>
        <div class="pillar">
          <h3>Fast turnaround</h3>
          <p>
            Reported bugs are tracked and handled immediately, not left in a queue. New work
            moves in short steps, so you see progress every week.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="card card--raised case">
        <p class="case__client">Smash Factor Lounge <span>· multi-location golf simulators</span></p>
        <h2>The third attempt that shipped</h2>
        <p class="muted">
          Two developers before couldn't finish their booking platform. Omnipeak rebuilt it from
          the ground up: reservations with time-based pricing, memberships with recurring billing,
          and a structure ready for new locations.
        </p>
        <ul class="case-meta">
          <li>Online booking</li>
          <li>Memberships</li>
          <li>Recurring billing</li>
          <li>Multi-location</li>
        </ul>
        <p class="case__note muted">
          Booking and billing is the hardest kind of small-business software. The work also ranges
          from internal dashboards to automations that replace a weekly manual routine.
        </p>
        <div class="btn-row">
          <a href="/work/" class="btn btn--ghost">Read the case study</a>
          <a href={SCHEDULING_URL} class="btn btn--primary">Book an intro call</a>
        </div>
        <p class="case__live">
          Live at <a href="https://smashfactorlounge.com" rel="noopener">smashfactorlounge.com</a>
        </p>
      </article>
    </div>
  </section>

  <section class="section section--dim">
    <div class="container">
      <SectionHeader
        title="If Omnipeak disappeared tomorrow, you'd still be fine"
        subtitle="Many clients come to Omnipeak after a bad experience with a developer. These rules apply to every project, in writing."
      />
      <div class="grid grid--2">
        <div class="card">
          <h3>You own everything</h3>
          <p>Code, repository, hosting, and payment accounts are in your name from day one.</p>
        </div>
        <div class="card">
          <h3>You can run it</h3>
          <p>An admin screen built for a non-technical owner. Change prices and records yourself.</p>
        </div>
        <div class="card">
          <h3>Documented handover</h3>
          <p>Written documentation, so any competent developer could pick it up tomorrow.</p>
        </div>
        <div class="card">
          <h3>No lock-in</h3>
          <p>No proprietary platform, no fee just to keep your own software running.</p>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
